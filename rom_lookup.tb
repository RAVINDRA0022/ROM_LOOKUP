`timescale 1ns / 1ps

module seven_segment_display_tb;

    reg [3:0] in;
    wire [6:0] out;

    seven_segment_display dut (
        .in(in),
        .out(out)
    );

    initial begin
        
        for (in = 0; in < 10; in = in + 1) begin
            #10; // wait 10ns
        end

        
        in = 4'b1111;
        #10;

        $finish;
    end

endmodule
